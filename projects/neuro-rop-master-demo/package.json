{
  "name": "neuro-rop-master-demo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "list": "remotion compositions src/index.ts",
    "build": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts RopChapterPreview",
    "still:manager": "remotion still src/index.ts NeuroRopManager",
    "still:admin": "remotion still src/index.ts NeuroRopAdmin",
    "still:outro": "remotion still src/index.ts NeuroRopOutro",
    "render:short": "remotion render src/index.ts RopChapterPreview out/rop-chapter.mp4 --frames=0-270",
    "render:manager:short": "remotion render src/index.ts NeuroRopManager out/manager-preview.mp4 --frames=0-270",
    "render:admin:short": "remotion render src/index.ts NeuroRopAdmin out/admin-preview.mp4 --frames=0-270",
    "render:outro:short": "remotion render src/index.ts NeuroRopOutro out/outro-preview.mp4 --frames=0-180"
  },
  "dependencies": {
    "@remotion/cli": "4.0.523",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.523"
  },
  "devDependencies": {
    "typescript": "5.9.2"
  }
}
